// Prisma Schema - MyMasjid Backend
// https://pris.ly/d/prisma-schema-migration

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==================== Enums ====================

enum Role {
  USER
  DONOR
  VOLUNTEER
  MASJID_ADMIN
  ADMIN
  SUPER_ADMIN
}

enum RegistrationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  DENIED
  ACTIVE
}

enum OtpPurpose {
  DONOR_REGISTRATION
  VOLUNTEER_REGISTRATION
  LOGIN
  PASSWORD_RESET
}

enum CampaignPublicationStatus {
  DRAFT
  PUBLISHED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum ProjectMilestoneStatus {
  COMPLETED
  IN_PROGRESS
  UPCOMING
}

enum ConstructionLogType {
  DAILY
  WEEKLY
}

enum ProjectMediaKind {
  IMAGE
  VIDEO
  THREE_D_RENDER
}

enum ExpenditureStatus {
  PENDING
  APPROVED
  PAID
  VOID
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  VOID
}

// ==================== Models ====================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  masjids       Masjid[]
  donor         Donor?
  volunteer     Volunteer?
  refreshTokens RefreshToken[]
  documents     UploadedDocument[]

  @@map("users")
}

model Campaign {
  id                String                    @id @default(uuid())
  masjidId          String
  masjid            Masjid                    @relation(fields: [masjidId], references: [id], onDelete: Cascade)
  name              String?
  category          String?
  project           String?
  description       String?
  coverImageUrl     String?
  coverImagePublicId String?
  videoUrl          String?
  videoPublicId     String?
  gallery           Json                      @default("[]")
  goal              Decimal?                  @db.Decimal(14, 2)
  currency          String                    @default("GBP")
  startDate         DateTime?
  endDate           DateTime?
  donationTiers     Json                      @default("[]")
  story             String?
  impact            String?
  faqs               Json                      @default("[]")
  publicationStatus CampaignPublicationStatus @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?

  @@index([masjidId, publicationStatus])
  @@index([startDate, endDate])
  @@map("campaigns")
}

model Project {
  id                   String        @id @default(uuid())
  masjidId             String
  masjid               Masjid        @relation(fields: [masjidId], references: [id], onDelete: Cascade)
  name                 String
  category             String
  managerName          String
  location             String
  description          String
  coverImageUrl        String?
  status               ProjectStatus @default(PLANNED)
  currency             String        @default("GBP")
  estimatedTotalCost   Decimal?      @db.Decimal(14, 2)
  fundraisingGoal      Decimal?      @db.Decimal(14, 2)
  seedFunding          Decimal       @default(0) @db.Decimal(14, 2)
  raisedAmount         Decimal       @default(0) @db.Decimal(14, 2)
  constructionProgress Int           @default(0)
  notice               String?
  startDate            DateTime?
  completionDate       DateTime?
  fundingSources       Json          @default("[]")
  media                Json          @default("[]")
  complianceDocuments  Json          @default("[]")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  milestones        ProjectMilestone[]
  constructionLogs  ConstructionLog[]
  assets            ProjectAsset[]
  contractorReports ContractorReport[]
  budgetAllocations BudgetAllocation[]
  expenditures      Expenditure[]
  invoices           Invoice[]
  budgetForecasts    BudgetForecast[]

  @@index([masjidId, status])
  @@index([masjidId, category])
  @@index([masjidId, createdAt])
  @@map("projects")
}

model ProjectMilestone {
  id                String                 @id @default(uuid())
  projectId         String
  project           Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name              String
  phaseLabel        String?
  description       String?
  status            ProjectMilestoneStatus @default(UPCOMING)
  durationWeeks     Int?
  progressPercent   Int                    @default(0)
  plannedStartDate  DateTime?
  dueDate           DateTime?
  completedAt       DateTime?
  primaryContractor String?
  leadEngineer      String?
  position          Int                    @default(0)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?

  constructionLogs ConstructionLog[]
  assets            ProjectAsset[]
  comments          MilestoneComment[]
  updates           MilestoneUpdate[]

  @@index([projectId, status, position])
  @@index([projectId, dueDate])
  @@map("project_milestones")
}

model MilestoneComment {
  id          String           @id @default(uuid())
  milestoneId String
  milestone   ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  authorId    String
  authorName  String
  body        String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  @@index([milestoneId, createdAt])
  @@map("milestone_comments")
}

model MilestoneUpdate {
  id              String                 @id @default(uuid())
  milestoneId     String
  milestone       ProjectMilestone       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  authorId        String
  authorName      String
  message         String
  progressPercent Int?
  status          ProjectMilestoneStatus?
  createdAt       DateTime               @default(now())

  @@index([milestoneId, createdAt])
  @@map("milestone_updates")
}

model ConstructionLog {
  id                 String               @id @default(uuid())
  projectId          String
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId        String?
  milestone          ProjectMilestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  authorId            String
  authorName          String
  type                ConstructionLogType  @default(DAILY)
  logDate             DateTime
  title               String
  body                String
  progressPercent     Int?
  delayMinutes        Int                  @default(0)
  safetyIncident      Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  assets ConstructionLogAsset[]

  @@index([projectId, logDate])
  @@index([milestoneId])
  @@map("construction_logs")
}

model ConstructionLogAsset {
  id        String            @id @default(uuid())
  logId     String
  log       ConstructionLog   @relation(fields: [logId], references: [id], onDelete: Cascade)
  kind      ProjectMediaKind
  url       String
  label     String
  position  Int               @default(0)
  createdAt DateTime          @default(now())

  @@index([logId, position])
  @@map("construction_log_assets")
}

model ProjectAsset {
  id          String            @id @default(uuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  kind        ProjectMediaKind
  url         String
  label       String
  altText     String?
  position    Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  @@index([projectId, position])
  @@index([milestoneId])
  @@map("project_assets")
}

model ContractorReport {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  reportType      String
  contractorName  String?
  reportingPeriod String?
  description     String?
  fileUrl         String
  verified        Boolean  @default(false)
  verifiedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([projectId, createdAt])
  @@map("contractor_reports")
}

model BudgetAllocation {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  totalBudget      Decimal  @db.Decimal(14, 2)
  warningThreshold Int      @default(80)
  position         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  expenditures Expenditure[]
  invoices     Invoice[]

  @@index([projectId, position])
  @@map("budget_allocations")
}

model Expenditure {
  id               String            @id @default(uuid())
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  allocationId     String?
  allocation       BudgetAllocation? @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  vendor           String
  description      String
  amount           Decimal           @db.Decimal(14, 2)
  expenditureDate  DateTime
  status           ExpenditureStatus @default(PENDING)
  invoiceReference String?
  receiptUrl       String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  @@index([projectId, expenditureDate])
  @@index([allocationId])
  @@map("expenditures")
}

model Invoice {
  id           String            @id @default(uuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  allocationId String?
  allocation   BudgetAllocation? @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  vendor       String
  invoiceNumber String
  amount       Decimal           @db.Decimal(14, 2)
  dueDate      DateTime
  status       InvoiceStatus     @default(PENDING)
  paidAt       DateTime?
  documentUrl  String?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  @@unique([projectId, invoiceNumber])
  @@index([projectId, dueDate])
  @@index([allocationId])
  @@map("invoices")
}

model BudgetForecast {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  month          DateTime
  forecastAmount Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projectId, month])
  @@index([projectId, month])
  @@map("budget_forecasts")
}

model Donor {
  id               String             @id @default(uuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName         String?
  phoneCountryCode String?
  phoneNumber      String?
  address          String?
  city             String?
  country          String             @default("PK")
  dateOfBirth      DateTime?
  idType           String?
  idNumberEnc      String?
  interests        String[]
  registrationStep Int                @default(0)
  status           RegistrationStatus @default(DRAFT)
  emailVerified    Boolean            @default(false)
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  @@map("donors")
}

model Volunteer {
  id               String             @id @default(uuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName         String?
  phoneCountryCode String?
  phoneNumber      String?
  address          String?
  city             String?
  country          String             @default("PK")
  dateOfBirth      DateTime?
  idType           String?
  idNumberEnc      String?
  bio              String?
  skills           String[]
  interests        String[]
  availabilityDays String[]
  availabilityTimes String[]
  registrationStep Int                @default(0)
  status           RegistrationStatus @default(DRAFT)
  emailVerified    Boolean            @default(false)
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  @@map("volunteers")
}

model Masjid {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // --- Institutional identity (step 1) ---
  registrationNumber String?
  organizationType   String?
  charityNumber      String?
  email              String?
  phoneCountryCode   String?
  phoneNumber        String?
  address            String?
  city               String?
  state              String?
  country            String   @default("PK")
  website            String?
  establishedYear    Int?
  latitude           Float?
  longitude          Float?

  // --- Organization profile (step 2) ---
  description      String?
  missionStatement String?
  operatingHours   String?

  // --- Services & compliance flags (step 3) ---
  services               String[]
  handlesZakat           Boolean  @default(false)
  handlesGiftAid         Boolean  @default(false)
  hasCharityRegistration Boolean  @default(false)
  acceptsOnlineDonations Boolean  @default(false)
  complianceNotes        String?

  // --- Registration workflow (steps 4-5 + review) ---
  registrationStep Int                @default(0)
  status           RegistrationStatus @default(DRAFT)
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedBy       String?
  reviewNote       String?
  denialReasons    Json?
  emailVerified    Boolean            @default(false)

  trustees  Trustee[]
  documents UploadedDocument[]
  campaigns Campaign[]
  projects  Project[]

  @@index([status])
  @@index([ownerId])
  @@map("masjids")
}

model Trustee {
  id          String   @id @default(uuid())
  masjidId    String
  masjid      Masjid   @relation(fields: [masjidId], references: [id], onDelete: Cascade)
  fullName    String
  email       String
  phoneNumber String?
  role        String
  idType      String?
  idNumberEnc String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([masjidId])
  @@map("trustees")
}

model UploadedDocument {
  id           String   @id @default(uuid())
  masjidId     String?
  masjid       Masjid?  @relation(fields: [masjidId], references: [id], onDelete: SetNull)
  uploaderId   String
  uploader     User     @relation(fields: [uploaderId], references: [id])
  originalName String
  storedName   String
  mimeType     String
  size         Int
  purpose      String?
  filePath     String
  createdAt    DateTime @default(now())

  @@index([masjidId])
  @@map("uploaded_documents")
}

model Otp {
  id          String     @id @default(uuid())
  email       String
  purpose     OtpPurpose
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  lockUntil   DateTime?
  resendCount Int        @default(0)
  lastSentAt  DateTime?
  verifiedAt  DateTime?
  usedAt      DateTime?
  createdAt   DateTime   @default(now())

  @@index([email, purpose])
  @@map("otps")
}

model RefreshToken {
  id              String    @id @default(uuid())
  tokenHash       String    @unique
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  replacedByToken String?
  revokedAt       DateTime?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id          String    @id @default(uuid())
  email       String
  tokenHash   String?
  verifiedAt  DateTime?
  expiresAt   DateTime?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@map("password_resets")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  actorRole  String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}
