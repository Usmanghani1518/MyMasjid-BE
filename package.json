{
  "name": "mymasjid-be",
  "version": "1.0.0",
  "description": "MyMasjid Backend API - Node.js + Express + PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --require tsconfig-paths/register src/index.ts",
    "build": "tsc",
    "start": "node -r module-alias/register dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "express",
    "postgresql",
    "prisma",
    "typescript",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "_moduleAliases": {
    "@": "dist",
    "@config": "dist/config",
    "@modules": "dist/modules",
    "@middleware": "dist/middleware",
    "@services": "dist/services",
    "@utils": "dist/utils",
    "@types": "dist/types"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@scalar/express-api-reference": "^0.10.13",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}