# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/mymasjid_db?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Logging
LOG_LEVEL=info

# API Documentation (set to false in production to disable /docs)
ENABLE_API_DOCS=true
