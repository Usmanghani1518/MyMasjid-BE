PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:password@localhost:5432/mymasjid_db?schema=public"
TEST_DATABASE_URL=
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
ENCRYPTION_KEY="replace-with-output-of-openssl-rand-hex-32"
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
CORS_ORIGIN="http://localhost:5173"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="MyMasjid <your-gmail-address@gmail.com>"
RESEND_API_KEY=
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=8000
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
LOG_LEVEL=info
PRISMA_QUERY_LOGS=false
ENABLE_API_DOCS=true
