# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/mymasjid_db?schema=public"

# Integration tests use this schema (Prisma-only `schema=` param). If unset, integration tests skip.
# TEST_DATABASE_URL="postgresql://user:pass@host:5432/mymasjid_db?sslmode=require&schema=test"

# JWT / Tokens
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
REGISTRATION_TOKEN_EXPIRES_IN="30m"
REFRESH_TOKEN_SECRET="your-super-secret-refresh-key-change-this-in-production"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Sensitive data encryption (AES-256-GCM) — any secret >= 16 chars
ENCRYPTION_KEY="your-encryption-key-at-least-16-chars"

# OTP
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15

# CORS / Uploads — comma-separated allowed origins
CORS_ORIGIN="http://localhost:5173"
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10

# Email (SMTP optional — falls back to console logging in dev)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASS=pass
SMTP_FROM="MyMasjid <no-reply@mymasjid.org>"
FRONTEND_URL="http://localhost:5173"

# Logging
LOG_LEVEL=info

# API Documentation (set to false in production to disable /docs)
ENABLE_API_DOCS=true
